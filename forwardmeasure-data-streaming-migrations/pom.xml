<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.forwardmeasure.datastreaming</groupId>
    <artifactId>forwardmeasure-data-streaming-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>forwardmeasure-data-streaming-migrations</artifactId>
  <name>ForwardMeasure Data Streaming Migrations</name>
  <description>FDS's journal provisioning for the platform migrations stage: its runtime role and,
    in each tenant database, the data_streaming schema with Pekko's journal and snapshot tables;
    on pekko-cassandra installations, its own journal and snapshot keyspaces. Uses fowf's shared
    tenant migrators rather than a second provisioning implementation.</description>

  <properties>
    <!-- Build runtime/frontend assemblies fresh; cache reuse is reserved for libraries. -->
    <maven.build.cache.skipCache>true</maven.build.cache.skipCache>
    <maven.build.cache.skipSave>true</maven.build.cache.skipSave>

    <maven.javadoc.skip>false</maven.javadoc.skip>
    <container-image.name>data-streaming-migrations</container-image.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-migration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.jpa</groupId>
      <artifactId>forwardmeasure-jpa-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.cassandra</groupId>
      <artifactId>java-driver-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-cassandra</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- A plain Java main() entrypoint (DataStreamingMigrationsMain), packaged like the executors. -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- migrations run before either engine and carry neither. -->
            <id>enforce-engine-independence</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>The delivery engines are independent: migrations run before either engine and carry neither.</message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.apache.pekko:*:*:*:compile</exclude>
                    <exclude>org.apache.pekko:*:*:*:runtime</exclude>
                    <exclude>org.apache.kafka:kafka-streams:*:*:compile</exclude>
                    <exclude>org.apache.kafka:kafka-streams:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.forwardmeasure.datastreaming.migrations.DataStreamingMigrationsMain</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>dependency/</classpathPrefix>
            </manifest>
            <!-- extensions/ lets a product (or a test image) add classes such as its own
                 NamedTransformProvider without rebuilding this image. -->
            <manifestEntries><Class-Path>extensions/</Class-Path></manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                    <args>
                      <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                      <DEPENDENCY_DIR>target/dependency</DEPENDENCY_DIR>
                      <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>