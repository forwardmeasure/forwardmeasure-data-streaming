helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true
  createNamespace: true

# Same coordinate forwardmeasure-openworkflow's own deploy/helmfile and data-fabric's own
# platform-helmlines-setup already resolve this chart from - no vendoring needed.
repositories:
  - name: forwardmeasure
    url: https://forwardmeasure.github.io/helm-charts

environments:
  gcp-openworkflow-prod:
    values:
      - environments/base.yaml
      - environments/gcp-openworkflow-prod.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/common.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/chart-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/image-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/clusters/gcp-openworkflow-prod.yaml.gotmpl

{{- /* Same pattern forwardmeasure-openworkflow's own top-level helmfile.yaml.gotmpl uses: a
list of file paths per environment, passed through to each sub-helmfile explicitly, not
.Environment.Values (which isn't the real mechanism helmfile uses here). */}}
{{- $envLayers := dict
  "gcp-openworkflow-prod" (list "environments/base.yaml" "environments/gcp-openworkflow-prod.yaml.gotmpl" "../../../forwardmeasure-platform/deploy/helmfile/shared/common.yaml.gotmpl" "../../../forwardmeasure-platform/deploy/helmfile/shared/chart-versions.yaml" "../../../forwardmeasure-platform/deploy/helmfile/shared/image-versions.yaml" "../../../forwardmeasure-platform/deploy/helmfile/shared/clusters/gcp-openworkflow-prod.yaml.gotmpl")
}}
{{- $envFiles := index $envLayers .Environment.Name | default (list) }}

helmfiles:
  - path: helmfiles/launcher.yaml.gotmpl
    values: {{ toYaml $envFiles | nindent 6 }}
