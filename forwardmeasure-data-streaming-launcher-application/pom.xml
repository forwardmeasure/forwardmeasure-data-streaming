<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.forwardmeasure.datastreaming</groupId><artifactId>forwardmeasure-data-streaming-parent</artifactId><version>${revision}</version></parent>
  <artifactId>forwardmeasure-data-streaming-launcher-application</artifactId>
  <name>ForwardMeasure Data Streaming Launcher Application</name>
  <description>Framework-agnostic orchestration for the async REST launcher, in both its real forms
    (2026-09-13): DirectIngestionLauncher runs an IngestionSpec as one real K8s Job, bypassing fowf's
    workflow engine entirely, by delegating to openworkflow-kubernetes-job-lifecycle - the same
    library fowf's own AsyncApiKubernetesJobOperationExecutor uses. WorkflowIngestionLauncher instead
    starts a real fowf workflow execution through fowf's own generated ExecutionsApi client SDK
    (POST /v1/executions) - Kubernetes specifics live entirely in that workflow's own definition,
    never touched here. Direct mode's own scope boundary (pekko engine only, not yet spark - see
    DirectIngestionLauncher's own javadoc) is real and documented, not silently gapped.

    Deliberately depends on nothing framework-specific (no JAX-RS, no CDI) - matching
    DossierApplicationService's own shape (manifesto Principle 7): this is the layer a REST resource
    calls into, not the layer that knows it's being called over HTTP at all. Neither launcher builds
    or configures its own KubernetesClient/ExecutionsApi/ApiClient - how a caller authenticates
    (Kubernetes client config, fowf bearer-token acquisition) is an environment-specific decision
    that belongs to whichever framework binding constructs these classes, not to this
    framework-agnostic module.</description>
  <properties>
    <!-- Has real public classes to document now (unlike this repo's still-scaffolded modules) -
         see the parent pom's own default. -->
    <maven.javadoc.skip>false</maven.javadoc.skip>
  </properties>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-api</artifactId></dependency>
    <dependency>
      <!-- ExecutionPlanCompiler - the planner DirectIngestionLauncher calls to resolve which
           DeliveryEngineKind a spec runs on (2026-09-21, once the unified IngestionSpec removed the
           author-specified engine string this launcher used to read). -->
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-core</artifactId>
    </dependency>
    <dependency>
      <!-- Direct-mode: real K8s Job launch/observe/cancel, shared with fowf's own
           AsyncApiKubernetesJobOperationExecutor - see that repo's own module of the same name. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-kubernetes-job-lifecycle</artifactId>
    </dependency>
    <dependency>
      <!-- Workflow-mode: fowf's own generated Apache-HttpClient SDK for /v1/executions - a real
           REST call to an already-running fowf execution-management service, not a hand-rolled
           HTTP client. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-execution-client-apachehttp</artifactId>
    </dependency>
    <dependency>
      <!-- Execution/ExecutionStart/ExecutionControl/ExecutionState - the request/response models
           this module's own code references directly, not just transitively through the client. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-execution-models</artifactId>
    </dependency>
    <dependency>
      <!-- AuthorizationService/AuthorizationRequest/ActiveOrganization/Action - real, fail-closed
           caller authorization for all three launchers, added 2026-09-14 to close a confirmed gap
           (every endpoint ran with zero authorization - see
           docs/fds-authorization-remediation-guide.md). Depended on directly rather than ported
           locally: the whole point of the 2026-09-14 fowf/fei/FDS AuthZEN consolidation was that
           this transport contract belongs in one shared library, not a third product-local copy. -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-api</artifactId>
    </dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency>
      <!-- Real, no-mocks proof of direct mode against an actual single-node K3s cluster. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kubernetes</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only: with no SLF4J provider on the classpath, every logger call in this module's
           own tests (and fabric8/Pekko's own internal logging) is silently a no-op - real output is
           needed to see what a long-running real-image K3s test is actually doing while it runs,
           same reasoning as -executor-pekko's own pom. -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The real Keycloak AuthZEN PDP client - DirectIngestionLauncherKeycloakIntegrationTest's
           own proof that this launcher's real authorize(...) call reaches a genuine Keycloak 26.7
           AuthZEN evaluation, not a fake/stubbed one, mirroring
           forwardmeasure-authzen-client's own AuthzenAuthorizationServiceKeycloakIntegrationTest. -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- AuthzenKeycloakFixture - real Keycloak 26.7 AuthZEN container, used directly by
           DirectIngestionLauncherKeycloakIntegrationTest. StubAuthorizationService (this testkit
           module's other former export) was removed repo-wide 2026-09-20 - every other test in this
           module now uses a small, file-local fake instead of a shared stub. -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase D (2026-09-21): the real live fowf fixture (execution-management + engine-kafka-
           streams + operation-adapter + definition-management, all real Docker images) needs its
           own real Postgres - fowf's own platform/tenant-registry database, migrated by the real
           openworkflow-migrations image, never a mock or an in-memory substitute. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase D: fowf's own execution-management/engine/operation-adapter all validate a real
           Bearer JWT against OPENWORKFLOW_KEYCLOAK_ISSUER - the same Keycloak container
           AuthzenKeycloakFixture already stands up for this launcher's own authorization check is
           reused as that issuer (confirmed: fowf's QuarkusActiveOrganizationProvider reads the
           identical com.forwardmeasure.authzen.KeycloakOrganizationClaims shape). -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-keycloak</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase D: fowf's own kafka-streams engine needs a real Kafka broker (OPENWORKFLOW_KAFKA_
           BOOTSTRAP_SERVERS) - the same real module this repo's own -executor-kafka-streams/
           -executor-pekko already use. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase D: publishing a real WorkflowDefinition against the real definition-management
           image, mirroring forwardmeasure-entity-intelligence's own real, already-proven
           WorkflowDefinitionPublisherMain. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-definition-management-client-apachehttp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-definition-management-models</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase D: granting fowf's own real, server-side AuthZEN resource/scope for the fixture's
           minted token - see this repo's own root pom for the full "why". -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-authorization-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- DirectIngestionLauncherKafkaStreamsRealImageIntegrationTest's own real KafkaProducer,
           seeding one real WorldCheck row onto a real topic before dispatch. -->
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- DirectIngestionLauncherKafkaStreamsRealImageIntegrationTest's own real OpenSearch sink -
           the real Kafka Streams executor's own BoundedKafkaConsumerRunner writes there via
           OpenSearchSinkRowWriter, matched here so the test can independently verify the write. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-opensearch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The real, shared WorldCheck IngestionSpec/TSV fixtures (Phase F) - reused here so the
           real Kafka Streams executor image gets proven against genuine WorldCheck field-mapping
           business logic, the same level of proof as PekkoWorldCheckToOpenSearchIntegrationTest
           already gives the Pekko engine, not a toy id/name spec. -->
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-test-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- Phase G (2026-09-24): RealFowfWorkflowFixture (the real 6-service fowf boot machinery)
             is the one real, working proof this module's own workflow-bounded tests already use -
             a per-framework matrix cell (launcher/quarkus, /spring, /micronaut) needs to reuse it
             directly rather than duplicate ~800 lines of container-orchestration code per framework.
             A test-jar is the standard Maven way to make one module's own test-scoped classes
             consumable from another module's test scope. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
