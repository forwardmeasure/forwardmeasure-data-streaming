<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.forwardmeasure.datastreaming</groupId><artifactId>forwardmeasure-data-streaming-parent</artifactId><version>${revision}</version></parent>
  <artifactId>forwardmeasure-data-streaming-launcher-jaxrs</artifactId>
  <name>ForwardMeasure Data Streaming Launcher JAX-RS</name>
  <description>JAX-RS resource classes over launcher-application, built 2026-09-13: IngestionRunResource
    (POST/GET/cancel /ingestion-runs - direct, single-source Pekko), CorrelationRunResource
    (POST/GET/cancel /correlation-runs - direct, multi-source Spark), WorkflowRunResource
    (POST/GET/cancel /workflow-runs - through fowf's own execution-management API) - shared,
    unmodified, across all three framework bindings (Quarkus's native RESTEasy, Spring via its
    JAX-RS bridge, Micronaut's own JAX-RS support), the same shared-JAX-RS-resource convention
    already established elsewhere in this org (e.g.
    forwardmeasure-entity-intelligence-ingestion-service-jaxrs). jakarta.ws.rs-api only, provided
    scope - the actual JAX-RS runtime comes from whichever framework binding assembles this.</description>
  <properties>
    <!-- Has real public classes to document now (unlike this repo's still-scaffolded modules) -
         see the parent pom's own default. -->
    <maven.javadoc.skip>false</maven.javadoc.skip>
  </properties>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-launcher-application</artifactId></dependency>
    <dependency>
      <!-- ActiveOrganizationProvider (identity extracted upstream by whichever framework binding
           assembles this resource) and AuthorizationDeniedException/AuthorizationUnavailableException/
           AuthenticationRequiredException, mapped by this module's own new mapper classes - see
           SecurityExceptionMapper's own javadoc for why those three are deliberately NOT
           SecurityException (reserved here for IngestionJobPolicy's distinct 403 case). -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-api</artifactId>
    </dependency>
    <dependency><groupId>jakarta.ws.rs</groupId><artifactId>jakarta.ws.rs-api</artifactId><scope>provided</scope></dependency>
    <dependency>
      <!-- Every error as an RFC 9457 problem, on every framework: the shared request-contract mappers
           (body that doesn't bind, bean validation, any WebApplicationException or unhandled
           failure) plus RequestProblems for this module's own mappers. -->
      <groupId>com.forwardmeasure.platform</groupId>
      <artifactId>forwardmeasure-platform-server-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.platform</groupId>
      <artifactId>forwardmeasure-platform-api-contracts</artifactId>
    </dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency>
      <!-- StubAuthorizationService.permitAll() - these resource tests prove real HTTP wiring
           (status codes, Location, response bodies), not the AuthZEN decision itself, matching
           forwardmeasure-entity-intelligence's own tests. -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only JAX-RS RuntimeDelegate - jakarta.ws.rs-api alone (provided scope, no impl) can't
           actually construct a Response at runtime; this org's own established fix for exactly this
           gap in a plain-resource-class unit test (see fowf's own openworkflow-definition-management
           -jaxrs pom). Never main-scope: the real runtime still comes from whichever framework
           binding assembles this module, unchanged. -->
      <groupId>org.glassfish.jersey.core</groupId>
      <artifactId>jersey-common</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Real, no-mocks proof of the K8s-backed resources against an actual single-node K3s
           cluster, same pattern launcher-application's own tests already use. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kubernetes</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId><artifactId>openapi-generator-maven-plugin</artifactId>
        <executions><execution><id>launcher-contract</id><phase>generate-sources</phase><goals><goal>generate</goal></goals>
          <configuration>
            <inputSpec>${project.basedir}/../forwardmeasure-data-streaming-api/src/main/resources/openapi/launcher.yaml</inputSpec>
            <generatorName>jaxrs-spec</generatorName>
            <templateDirectory>${project.basedir}/src/main/oas-templates</templateDirectory>
            <apiPackage>com.forwardmeasure.datastreaming.launcher.contract</apiPackage>
            <generateModels>false</generateModels><generateSupportingFiles>false</generateSupportingFiles>
            <generateApiTests>false</generateApiTests><generateApiDocumentation>false</generateApiDocumentation>
            <schemaMappings>
              <schemaMapping>IngestionSpec=com.forwardmeasure.datastreaming.api.IngestionSpec</schemaMapping>
              <schemaMapping>DirectLaunchRequest=com.forwardmeasure.datastreaming.launcher.application.DirectLaunchRequest</schemaMapping>
              <schemaMapping>WorkflowLaunchRequest=com.forwardmeasure.datastreaming.launcher.application.WorkflowLaunchRequest</schemaMapping>
              <schemaMapping>RunAccepted=com.forwardmeasure.datastreaming.launcher.jaxrs.dto.RunAccepted</schemaMapping>
              <schemaMapping>Problem=com.forwardmeasure.openworkflow.common.model.Problem</schemaMapping>
            </schemaMappings>
            <importMappings>
              <importMapping>DirectLaunchRequest=com.forwardmeasure.datastreaming.launcher.application.DirectLaunchRequest</importMapping>
              <importMapping>WorkflowLaunchRequest=com.forwardmeasure.datastreaming.launcher.application.WorkflowLaunchRequest</importMapping>
              <importMapping>RunAccepted=com.forwardmeasure.datastreaming.launcher.jaxrs.dto.RunAccepted</importMapping>
              <importMapping>Problem=com.forwardmeasure.openworkflow.common.model.Problem</importMapping>
            </importMappings>
            <addCompileSourceRoot>true</addCompileSourceRoot>
            <configOptions>
              <sourceFolder>src/main/java</sourceFolder>
              <interfaceOnly>true</interfaceOnly><returnResponse>true</returnResponse>
              <useJakartaEe>true</useJakartaEe><useSwaggerAnnotations>false</useSwaggerAnnotations>
              <useBeanValidation>false</useBeanValidation><useTags>true</useTags>
              <hideGenerationTimestamp>true</hideGenerationTimestamp><sortParamsByRequiredFlag>false</sortParamsByRequiredFlag>
            </configOptions>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
