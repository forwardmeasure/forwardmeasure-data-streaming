<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.forwardmeasure.datastreaming</groupId><artifactId>forwardmeasure-data-streaming-parent</artifactId><version>${revision}</version></parent>
  <artifactId>forwardmeasure-data-streaming-mappers</artifactId>
  <name>ForwardMeasure Data Streaming Mappers</name>
  <description>The runtime field-mapping engine: walks a TransformSpec/FieldRule list (D3, corrected)
    and dispatches each field through forwardmeasure-data-streaming-transforms' NamedTransformRegistry,
    ported directly from forwardmeasure-entity-intelligence's own GenericRecordMapper (minus its
    Protobuf-specific coercion step, which is D1's separate, explicitly-deferred concern - see the
    design plan's §5). Produces a schema-agnostic Map&lt;String,Object&gt; per row today; typed
    coercion against a generated OpenAPI model class (D1) is real follow-on work, not yet built. Not
    MapStruct: this mapping is metadata-driven (a new source is onboarded by writing a new
    TransformSpec, not by generating or compiling new Java code) - MapStruct's real place in this
    architecture is JPA entity-to-model conversion, in forwardmeasure-data-streaming-connector-jdbc.</description>
  <properties>
    <!-- Has real public classes to document (unlike this repo's still-scaffolded modules) - see
         the parent pom's default. -->
    <maven.javadoc.skip>false</maven.javadoc.skip>
  </properties>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-api</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-transforms</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency>
      <!-- OpenSearchSinkRowWriter's own JSON body serialization - same real need
           PekkoIngestionRunner's own Camel sink has, ported here for the shared SinkRowWriter. -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.forwardmeasure.testcontainers</groupId><artifactId>forwardmeasure-testcontainers-opensearch</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.forwardmeasure.testcontainers</groupId><artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
