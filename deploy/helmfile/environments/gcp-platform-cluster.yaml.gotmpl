# Profile for the data-streaming launcher on a GCP cluster running the shared
# forwardmeasure-platform, used by the gcp-openworkflow-prod and gcp-greenfield-example
# environments (was gcp-openworkflow-prod.yaml.gotmpl).
# Nothing here is specific to one cluster: cluster facts (domain, tenants, endpoints, GCP project,
# Cloud SQL instance) come from that environment's forwardmeasure-platform shared cluster file
# (shared/clusters/<env>.yaml.gotmpl), loaded after this one.

# Which framework's image this cluster actually runs - matches data-fabric-devops's own real,
# already-deployed choice (only quarkus has a real, pushed launcher image today; spring/micronaut
# exist for the test matrix's own parity proof, not as a second real deployment).
launcherFramework: quarkus

imagePullPolicy: Always

# Cluster facts, Kafka/fowf/Keycloak endpoints, the organization client (forwardmeasure-public) and
# the image-pull Secret come from forwardmeasure-platform/deploy/helmfile/shared/ (common.yaml.gotmpl
# and clusters/<env>.yaml.gotmpl) - read by helmfiles/launcher.yaml.gotmpl as
# .Values.platform.*.

# datastreaming is this launcher's own AuthZEN resource-authorization client id (same id
# data-fabric-devops's own release already assumes exists) - NOT YET CONFIRMED to be registered in
# THIS cluster's own Keycloak realm (forwardmeasure-openworkflow's Keycloak is a genuinely separate
# instance from data-fabric-prod's - a client registered in one does not exist in the other).
# Real, unresolved precondition: confirm or provision this client in the forwardmeasure realm here
# before applying.
authorizationClientId: datastreaming

# Real, unresolved precondition: the shared image-pull Secret (platform.secrets.imagePull,
# docker-io-credentials) is not yet provisioned in this namespace specifically.

# ExternalSecret-synced, mirroring forwardmeasure-platform's own platform-secrets convention
# (openworkflow-identity-credentials's own precedent) rather than a manually-created Secret -
# real, unresolved precondition: forwardmeasure-platform's platform-secrets release needs a new
# entry for this (see deploy/helmfile/data-streaming-launcher-credentials.yaml.gotmpl in this same
# directory for the exact keys it must carry), backed by real GCP Secret Manager entries that don't
# exist yet. Nothing here invents a value for it.
credentialsSecretName: data-streaming-launcher-credentials

