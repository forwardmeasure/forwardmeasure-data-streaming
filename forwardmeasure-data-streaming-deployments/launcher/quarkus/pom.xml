<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.datastreaming</groupId>
    <artifactId>forwardmeasure-data-streaming-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>forwardmeasure-data-streaming-launcher-quarkus-service</artifactId>
  <name>ForwardMeasure Data Streaming :: Deployments :: Launcher :: Quarkus</name>
  <description>The actual bootable, containerizable Quarkus deployable for the ingestion launcher -
    assembles forwardmeasure-data-streaming-launcher-quarkus (CDI wiring) with
    forwardmeasure-data-streaming-launcher-jaxrs (the shared REST resources). Mirrors
    forwardmeasure-entity-intelligence-deployments' real leaf-deployment shape exactly.</description>
  <properties>
    <container-image.name>data-streaming-launcher-quarkus</container-image.name>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform-quarkus-bom</artifactId>
        <version>${forwardmeasure.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-launcher-quarkus-bindings</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- Real REST layer - the binding module deliberately carries none of its own, matching
           fowf's/fei's own binding-vs-deployments split exactly. -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <!-- Real, previously-missing dependency (found 2026-09-25 while wiring real Helm probes):
           without it, /q/health/{live,ready,started} all 404 and a real Knative/Kubernetes
           liveness/readiness/startup probe against this image never succeeds. Matches
           forwardmeasure-entity-intelligence's own ingestion-service-quarkus pom - same real gap,
           already found and fixed there once. Unversioned - covered by
           forwardmeasure-platform-quarkus-bom's own dependencyManagement. -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The real, first-ever end-to-end boot proof for this deployable - Phase G's own matrix
           (see the repo's own gap-bridging plan) - needs the real WorldCheck fixture, a real
           Keycloak testcontainer for both this launcher's own AuthorizationService and inbound JWT
           verification, and real K3s/Kafka/OpenSearch testcontainers to dispatch into. -->
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-test-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kubernetes</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-opensearch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- DirectIngestionMatrixQuarkusKafkaStreamsSmokeTest's own real Kafka broker, matching
           -launcher-application's own DirectIngestionLauncherKafkaStreamsRealImageIntegrationTest
           dependency. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Real KafkaProducer, seeding one real WorldCheck row before dispatch. -->
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Real, live-verified gap (found 2026-09-21): Quarkus's own @QuarkusTestResource
           classloader does not pick up org.opensearch:opensearch-testcontainers transitively
           through forwardmeasure-testcontainers-opensearch the way plain Surefire/JUnit does for
           every other real consumer (confirmed live: ClassNotFoundException at
           QuarkusTestResourceLifecycleManager#start time, even though `mvn dependency:tree`
           confirms it's genuinely resolved onto this module's own test classpath) - declaring it
           directly here works around whatever Quarkus-specific classpath partitioning causes that.
           Same version forwardmeasure-testcontainers-opensearch itself pins. -->
      <groupId>org.opensearch</groupId>
      <artifactId>opensearch-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Phase G workflow-bounded matrix cell: reuses RealFowfWorkflowFixture directly (the real
           6-service fowf boot machinery -launcher-application's own workflow-bounded tests already
           use) rather than duplicating ~800 lines of container-orchestration code per framework. -->
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-launcher-application</artifactId>
      <version>${project.version}</version>
      <classifier>tests</classifier>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- RealFowfWorkflowFixture's own real Postgres (fowf's platform/tenant-registry database). -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-JAR dependencies do not inherit the fixture's test-scoped backend containers. -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-cassandra</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Publishing a real WorkflowDefinition against the real definition-management image. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-definition-management-client-apachehttp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-definition-management-models</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Granting fowf's own real, server-side AuthZEN resource/scope for the fixture's minted
           token. -->
      <groupId>com.forwardmeasure.openworkflow</groupId>
      <artifactId>openworkflow-authorization-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals><goal>build</goal></goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals><goal>push</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
