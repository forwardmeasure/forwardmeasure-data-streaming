helmDefaults:
  # The charts are the only source of truth: on server-side apply, take back any field a manual
  # kubectl set/patch/edit claimed, rather than failing the release on the conflict.
  forceConflicts: true
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true

releases:
  - name: data-streaming-credentials
    namespace: {{ .Values.platform.namespaces.dataStreaming }}
    chart: ../releases/data-streaming-credentials
    installed: false
    labels: {stage: launcher, component: retired-client-writer}
  # The ServiceAccount continuous workers run as: on GCP it carries their Workload Identity, which
  # authorizes the Cloud SQL Auth Proxy sidecar beside each journal-backed Pekko worker.
  - name: data-streaming-worker-identity
    namespace: {{ .Values.platform.namespaces.dataStreaming }}
    chart: ../releases/data-streaming-worker-identity
    labels: {stage: launcher, component: worker-identity}
    values:
      - name: {{ .Values.workerServiceAccountName | quote }}
        gcpServiceAccount: {{ dig "platform" "cloud" "gcp" "dataStreaming" "serviceAccount" "" .Values | quote }}
  - name: data-streaming-launcher
    namespace: {{ .Values.platform.namespaces.dataStreaming }}
    # Same shared chart forwardmeasure-openworkflow's own execution-management/definition-management
    # releases already use in this exact cluster (helmfiles/execution-services.yaml.gotmpl) - not a
    # second, competing chart choice.
    chart: forwardmeasure/java-microservice
    version: {{ .Values.chartVersions.forwardMeasureJavaMicroservice | quote }}
    missingFileHandler: Error
    # credentialsSecretName above must already carry authorization-client-secret/fowf-keycloak-
    # client-id/fowf-keycloak-client-secret before this pod starts, or it comes up unable to
    # authenticate to fowf at all - see helmfiles/credentials.yaml.gotmpl.
    values:
      - serviceAccount:
          create: true
          name: data-streaming-launcher
        # Direct dispatch uses the in-cluster Kubernetes client. The chart grants this
        # account Job observation/lifecycle permissions in the launcher namespace.
        automountServiceAccountToken: true
        # Spark handoff state is stored in a ConfigMap by DirectIngestionLauncher;
        # the chart's automatic launcher Job role does not include ConfigMaps.
        rbac:
          create: true
          name: data-streaming-launcher-handoff
          rules:
            - apiGroups: [""]
              resources: ["configmaps"]
              verbs: ["create", "get", "delete"]
        terminationGracePeriodSeconds: 30
        podSecurityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        services:
          data-streaming-launcher:
            enabled: true
            # Plain Deployment, not Knative - matches every other real service already running in
            # this cluster (forwardmeasure-openworkflow's own execution-management/definition-
            # management/engines all use deploymentMode: deployment); data-fabric-devops's own
            # data-streaming-launcher release used Knative, but that was data-fabric-prod's own
            # established convention, not something confirmed to exist in this cluster - don't
            # assume it here.
            deploymentMode: deployment
            framework: {{ .Values.platform.framework }}
            runtime: jvm
            port: 8080
            database:
              enabled: false
            liquibaseWait:
              enabled: false
            emptyDirVolumeMounts:
              - name: tmp
                mountPath: /tmp
            # The chart sets spec.replicas from scaling.initialReplicas (a bare `replicas:` is ignored).
            scaling: {initialReplicas: 1}
            resources:
              requests: {cpu: "250m", memory: "512Mi"}
              limits: {cpu: "1000m", memory: "1Gi"}
            image:
              # The launcher image for forwardmeasure-platform's platform.framework (environments/
              # base.yaml imageVersions.launcher). No registry prefix - java-microservice-helm-chart's
              # imageRef helper always prepends .image.registry (default "docker.io").
              repository: {{ index .Values.imageVersions.launcher.repositories .Values.platform.framework | quote }}
              tag: {{ .Values.imageVersions.launcher.tag | quote }}
              digest: {{ index .Values.imageVersions.launcher.digests .Values.platform.framework | quote }}
              pullPolicy: {{ .Values.imagePullPolicy }}
            env:
              # Direct-mode (bypass-fowf) dispatch target - this release's own namespace only.
              DATASTREAMING_LAUNCHER_K8S_NAMESPACES: {{ .Values.platform.namespaces.dataStreaming | quote }}
              # The installation's one delivery engine (forwardmeasure-platform's platform.engine);
              # the launcher dispatches only that engine's runner, plus the loader on Kafka Streams.
              DATASTREAMING_LAUNCHER_ENGINE: {{ .Values.platform.engine | quote }}
              {{- /* repository@digest once pinned; repository:tag until the image is pushed and pinned. */}}
              {{- $ref := dict }}
              {{- range $name, $pin := dict "pekko" .Values.imageVersions.pekko "kafkaStreams" .Values.imageVersions.dataStreamingExecutorKafkaStreams "loader" .Values.imageVersions.loader "spark" .Values.imageVersions.spark "proxy" .Values.imageVersions.cloudSqlProxy }}
              {{- $_ := set $ref $name (ternary (printf "%s@%s" $pin.repository $pin.digest) (printf "%s:%s" $pin.repository $pin.tag) (ne (default "" $pin.digest) "")) }}
              {{- end }}
              {{- $pekko := $ref.pekko }}
              {{- $kafkaStreams := $ref.kafkaStreams }}
              {{- $loader := $ref.loader }}
              {{- $spark := $ref.spark }}
              {{- $journalProxy := and (ne .Values.platform.engine "pekko-cassandra") (dig "cloudSqlProxy" "enabled" false .Values) }}
              {{- if eq .Values.platform.engine "kafka-streams" }}
              DATASTREAMING_LAUNCHER_KAFKA_STREAMS_IMAGE: {{ $kafkaStreams | quote }}
              DATASTREAMING_LAUNCHER_KAFKA_STREAMS_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_LOADER_IMAGE: {{ $loader | quote }}
              DATASTREAMING_LAUNCHER_LOADER_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_K8S_IMAGES: {{ printf "%s,%s,%s" $kafkaStreams $loader $spark | quote }}
              {{- else }}
              DATASTREAMING_LAUNCHER_PEKKO_IMAGE: {{ $pekko | quote }}
              DATASTREAMING_LAUNCHER_PEKKO_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_K8S_IMAGES: {{ if $journalProxy }}{{ printf "%s,%s,%s" $pekko $spark $ref.proxy | quote }}{{ else }}{{ printf "%s,%s" $pekko $spark | quote }}{{ end }}
              # Continuous Pekko runs that correlate or keep state hold it on the Pekko journal:
              # the data_streaming schema of each tenant's database (pekko-postgresql), found
              # through the control plane's tenant_registry as the datastreaming role, or FDS's own
              # keyspaces on fowf's Cassandra (pekko-cassandra). The password is a secretKeyRef on
              # the worker - data-streaming-database-credentials, delivered by platform-secrets.
              {{- $role := .Values.platform.databases.runtimeRoles.dataStreaming }}
              {{- if eq .Values.platform.engine "pekko-cassandra" }}
              {{- $cassandra := printf "openworkflow-dc1-service.%s.svc.cluster.local:9042" .Values.platform.namespaces.openworkflow }}
              DATASTREAMING_LAUNCHER_JOURNAL_ENV: {{ printf "FDS_JOURNAL_CASSANDRA_CONTACT_POINTS=%s;FDS_JOURNAL_CASSANDRA_LOCAL_DATACENTER=%s;FDS_JOURNAL_CASSANDRA_USERNAME=%s" (dig "journal" "cassandra" "contactPoints" $cassandra .Values) (dig "journal" "cassandra" "localDatacenter" "dc1" .Values) $role | quote }}
              DATASTREAMING_LAUNCHER_JOURNAL_SECRET_ENV: {{ printf "FDS_JOURNAL_CASSANDRA_PASSWORD=%s/password" .Values.platform.secrets.dataStreamingDatabase | quote }}
              {{- else }}
              DATASTREAMING_LAUNCHER_JOURNAL_ENV: {{ printf "FDS_JOURNAL_CONTROL_PLANE_URL=jdbc:postgresql://localhost:5432/%s;FDS_JOURNAL_POSTGRES_USER=%s" .Values.platform.databases.controlPlane $role | quote }}
              DATASTREAMING_LAUNCHER_JOURNAL_SECRET_ENV: {{ printf "FDS_JOURNAL_POSTGRES_PASSWORD=%s/password" .Values.platform.secrets.dataStreamingDatabase | quote }}
              {{- end }}
              {{- if $journalProxy }}
              # The worker reaches its tenant database on localhost:5432 through a Cloud SQL Auth
              # Proxy sidecar fowf adds beside it (instance name from the same Secret).
              DATASTREAMING_LAUNCHER_JOURNAL_DATABASE_PROXY_IMAGE: {{ $ref.proxy | quote }}
              DATASTREAMING_LAUNCHER_JOURNAL_DATABASE_PROXY_INSTANCE_SECRET: {{ printf "%s/db-cloud-sql-instance" .Values.platform.secrets.dataStreamingDatabase | quote }}
              # The proxy authorizes as the worker's Workload Identity (data-streaming-worker-identity).
              DATASTREAMING_LAUNCHER_JOURNAL_DATABASE_PROXY_SERVICE_ACCOUNT: {{ .Values.workerServiceAccountName | quote }}
              {{- end }}
              {{- end }}
              DATASTREAMING_LAUNCHER_SPARK_IMAGE: {{ $spark | quote }}
              DATASTREAMING_LAUNCHER_SPARK_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_K8S_IMAGE_PULL_SECRETS: {{ .Values.platform.secrets.imagePull | quote }}
              DATASTREAMING_LAUNCHER_KAFKA_BOOTSTRAP_SERVERS: {{ .Values.platform.endpoints.kafka.bootstrapServers | quote }}
              DATASTREAMING_LAUNCHER_FOWF_BASE_URL: {{ .Values.platform.endpoints.openworkflow.executionBaseUrl | quote }}
              DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_TOKEN_URL: {{ .Values.platform.endpoints.keycloak.tokenUrl | quote }}
              # Real bug fix (2026-09-26): none of the 4 vars below matched any real
              # @ConfigProperty/@Value key any of the 3 framework bindings actually read
              # (LauncherQuarkusBinding/LauncherSpringBinding/LauncherMicronautBinding all declare
              # `datastreaming.launcher.authorization.*`, no default value on any of the 7
              # properties AuthzenAuthorizationFactory.create(...) needs) - confirmed via direct
              # source read, not assumed. SmallRye Config/Spring relaxed binding/Micronaut all
              # derive the same env var name from that property path
              # (DATASTREAMING_LAUNCHER_AUTHORIZATION_*), which is what's used below now - the old
              # names (DATASTREAMING_KEYCLOAK_ISSUER, DATASTREAMING_ORGANIZATION_CLIENT_ID,
              # DATASTREAMING_AUTHORIZATION_CLIENT_ID/_ISSUER) never reached any of the 3
              # deployments' config at all; this launcher could never have booted as previously
              # wired. request-timeout/decision-ttl/maximum-cache-entries/policy-version were never
              # set under ANY name before - added here with the same defaults fowf's own
              # openworkflow.authorization block uses (application.yaml, engine-pekko/quarkus).
              DATASTREAMING_LAUNCHER_AUTHORIZATION_ISSUER: {{ .Values.platform.endpoints.keycloak.issuer | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_CLIENT_ID: {{ .Values.platform.identity.serviceClients.dataStreaming.clientId | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_ORGANIZATION_CLIENT_ID: {{ .Values.platform.identity.organizationClientId | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_REQUEST_TIMEOUT: {{ dig "authorization" "requestTimeout" "PT5S" .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_DECISION_TTL: {{ dig "authorization" "decisionTtl" "PT5S" .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_MAXIMUM_CACHE_ENTRIES: {{ dig "authorization" "maximumCacheEntries" 10000 .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_POLICY_VERSION: {{ dig "authorization" "policyVersion" "v1" .Values | quote }}
            secrets:
              - envVar: DATASTREAMING_LAUNCHER_AUTHORIZATION_CLIENT_SECRET
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: authorization-client-secret
              - envVar: DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_CLIENT_ID
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: fowf-keycloak-client-id
              - envVar: DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_CLIENT_SECRET
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: fowf-keycloak-client-secret
        imagePullSecrets:
          - name: {{ .Values.platform.secrets.imagePull }}
    labels: {stage: launcher, capability: data-streaming-launcher, framework: {{ .Values.platform.framework }}}
