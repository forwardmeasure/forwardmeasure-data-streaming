# Mirrors fei's own real forwardmeasure-entity-intelligence-ingestion-worker Dockerfile.jvm exactly
# (itself mirroring fowf's own openworkflow-migrations one) - the proven pattern for a plain
# (non-Quarkus/Spring/Micronaut) Java worker image in this org: maven-dependency-plugin's
# copy-dependencies + maven-jar-plugin's manifest Class-Path, not a hand-written -cp flag.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG APPLICATION_JAR
ARG DEPENDENCY_DIR
ARG APP_UID=10001
ARG APP_GID=10001
COPY --chown=${APP_UID}:${APP_GID} ${DEPENDENCY_DIR} /deployments/dependency/
COPY --chown=${APP_UID}:${APP_GID} ${APPLICATION_JAR} /deployments/application.jar
USER ${APP_UID}:${APP_GID}
WORKDIR /deployments
ENTRYPOINT ["java", "-jar", "/deployments/application.jar"]
