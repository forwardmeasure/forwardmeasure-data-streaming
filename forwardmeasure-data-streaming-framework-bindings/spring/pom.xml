<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.forwardmeasure.datastreaming</groupId><artifactId>forwardmeasure-data-streaming-framework-bindings</artifactId><version>${revision}</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>forwardmeasure-data-streaming-launcher-spring-bindings</artifactId>
  <name>ForwardMeasure Data Streaming Launcher Spring Bindings</name>
  <description>Spring wiring for launcher-jaxrs/launcher-application - @Configuration/@Bean
    definitions for whatever launcher-application's constructor needs, application.yml. Carries no
    REST resource classes of its own (shared, in launcher-jaxrs, via Spring's JAX-RS bridge) and
    never boots its own bootable app - see forwardmeasure-data-streaming-deployments/launcher/spring
    for the real deployable assembly.</description>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform-spring-bom</artifactId>
        <version>${forwardmeasure.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-launcher-jaxrs</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <dependency>
      <!-- ResourceConfigCustomizer/Jersey registration - confirmed necessary the same way
           forwardmeasure-entity-intelligence's own ingestion-service-spring-binding needed it. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jersey</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.glassfish.hk2.external</groupId>
          <artifactId>aopalliance-repackaged</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- Verified-JWT extraction (SpringActiveOrganizationProvider) and the real
           "authenticated by default" SecurityFilterChain, added 2026-09-14 to close a confirmed
           real gap - see docs/fds-authorization-remediation-guide.md - mirrors
           forwardmeasure-entity-intelligence's own spring-binding pom exactly. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <!-- 401/403 as the RFC 9457 problem Quarkus and Micronaut return. -->
      <groupId>com.forwardmeasure.platform</groupId>
      <artifactId>forwardmeasure-platform-spring-security</artifactId>
    </dependency>
    <dependency>
      <!-- AuthzenAuthorizationFactory.create(...) - the real Keycloak AuthZEN PDP client this
           module's own authorizationService(...) bean wires. -->
      <groupId>com.forwardmeasure.authzen</groupId>
      <artifactId>forwardmeasure-authzen-client</artifactId>
    </dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
