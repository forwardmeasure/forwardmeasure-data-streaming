<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.forwardmeasure.datastreaming</groupId>
    <artifactId>forwardmeasure-data-streaming-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>forwardmeasure-data-streaming-executor-kafka-streams</artifactId>
  <name>ForwardMeasure Data Streaming Kafka Streams Executor</name>
  <description>First real implementation of StreamingStageRunnerProvider: a continuous,
    topic-to-topic Kafka Streams stage (source topic is the ISB in, sink topic is the ISB out),
    reusing this repo's own FieldMappingEngine for the TransformSpec mapping step - the same
    field-resolution/named-transform logic the bounded Pekko/Spark executors already use, not a
    reimplementation. Deliberately not built on fowf's openworkflow-durable-processing command/
    aggregate kernel - see KafkaStreamsStageRunnerProvider's own javadoc for why that library's
    real shape doesn't fit a stateless map/filter stage. See this repo's own continuous-streaming
    gap-bridging plan for why Kafka Streams is the first provider and Pekko is a planned second
    one.
  </description>

  <properties>
    <maven.javadoc.skip>false</maven.javadoc.skip>
    <container-image.name>data-streaming-executor-kafka-streams</container-image.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-api</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-executor-streaming-api</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-mappers</artifactId>
    </dependency>
    <dependency>
      <!-- IngestionPipeline.MalformedRecordPolicy/SinkFailurePolicy - the same real malformed-
           record/sink-retry policy the bounded engines already use, reused here (2026-09-21) for
           KafkaStreamsDeliveryEngine's own continuous and bounded branches. -->
      <groupId>${project.groupId}</groupId>
      <artifactId>forwardmeasure-data-streaming-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-streams</artifactId>
    </dependency>
    <dependency>
      <!-- Plain kafka-clients Consumer/Producer/Admin - BoundedKafkaConsumerRunner's own
           InputFrontier poll loop (2026-09-21) doesn't use the Kafka Streams DSL runtime at all,
           which has no native "stop at these offsets" concept. -->
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Real (not test-scope): with no SLF4J provider on the runtime classpath, every LOGGER.*
         call in this module's own code (and Kafka Streams' own internal logging) silently goes
         nowhere in the real deployed image - the identical gap fei's own ingestion-worker pom
         already documented and fixed for the same reason, and the same fix just applied to this
         repo's own -executor-pekko sibling module. slf4j-simple is the minimal, zero-config
         provider (stdout, no separate config file) appropriate for a plain worker jar. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real Kafka broker for the end-to-end spike test, via the real @WithKafkaContainer
         extension (forwardmeasure-testcontainers-kafka module). -->
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Real OpenSearch node - KafkaStreamsDeliveryEngineIntegrationTest's own proof that both
           modes genuinely write to a real sink now, not just topic-out (2026-09-21). -->
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-opensearch</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- No Kafka Streams executor image existed before 2026-09-21 - this module is now, like
         -executor-pekko/-executor-spark, a plain Java main() entrypoint
         (KafkaStreamsDeliveryEngine), not a Quarkus/Spring/Micronaut app. Mirrors those two
         modules' own real, working configuration exactly: maven-dependency-plugin copies runtime
         deps to target/dependency/, maven-jar-plugin points the jar's own manifest Class-Path at
         them, so `java -jar` alone resolves the full classpath. -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.forwardmeasure.datastreaming.executor.kafkastreams.KafkaStreamsDeliveryEngine</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>dependency/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                    <args>
                      <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                      <DEPENDENCY_DIR>target/dependency</DEPENDENCY_DIR>
                      <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>