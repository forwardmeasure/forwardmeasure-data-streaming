<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.datastreaming</groupId>
        <artifactId>forwardmeasure-data-streaming-deployments</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>forwardmeasure-data-streaming-deployments-spring-parent</artifactId>
    <packaging>pom</packaging>
    <name>ForwardMeasure Data Streaming :: Deployable Assemblies :: Spring parent</name>
    <!--
    Parent for Spring modules: every third-party version comes from forwardmeasure-platform-spring-bom, which imports the Spring BOM first, so Spring decides the versions of everything it manages.
    A module declares which framework it belongs to only by choosing this parent; it never sets a
    version itself.
    -->

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.forwardmeasure.platform</groupId>
                <artifactId>forwardmeasure-platform-spring-bom</artifactId>
                <version>${forwardmeasure.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-upper-bound-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <!-- Reports every library this module would run at a LOWER version than
                                 something on its classpath was built against. Report-only for the first
                                 build after the framework-parent restructure; switch <fail> to true once
                                 the reported cases are resolved. -->
                            <fail>false</fail>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
