<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.forwardmeasure.datastreaming</groupId><artifactId>forwardmeasure-data-streaming-parent</artifactId><version>${revision}</version></parent>
  <artifactId>forwardmeasure-data-streaming-executor-spark</artifactId>
  <name>ForwardMeasure Data Streaming Spark Executor</name>
  <description>Distributed/correlation executor - generalizes what
    forwardmeasure-entity-intelligence's CorrelatedSourceIngestionWorker already proves in production
    (real SparkSession, real JavaRDD/Dataset&lt;Row&gt; operations), driven by this library's
    generated models/mappers instead of hand-wired Spark code specific to one source. Bulk, partition-
    column-driven JDBC extraction lives here, not in the JDBC connector - see D4/D5 in the design
    plan.</description>
  <properties>
    <!-- Has real public classes to document (unlike this repo's still-scaffolded modules) - see
         the parent pom's default. -->
    <maven.javadoc.skip>false</maven.javadoc.skip>
    <container-image.name>data-streaming-executor-spark</container-image.name>
  </properties>
  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-api</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-core</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-mappers</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>forwardmeasure-data-streaming-transforms</artifactId></dependency>
    <dependency><groupId>org.apache.spark</groupId><artifactId>spark-core_2.13</artifactId></dependency>
    <dependency><groupId>org.apache.spark</groupId><artifactId>spark-sql_2.13</artifactId></dependency>
    <!-- kafka source+sink (2026-09-13): SparkCorrelationEngine#readSource's generic
         .format(connector) dispatch and SparkSinks' own kafka writer both need Spark's own native
         kafka data source artifact on the classpath - not a Java dependency of either class, a
         Maven one. -->
    <dependency><groupId>org.apache.spark</groupId><artifactId>spark-sql-kafka-0-10_2.13</artifactId></dependency>
    <!-- jdbc source+sink (2026-09-13, fixing a real pre-existing gap): readSource()'s own jdbc
         branch has always set driver=org.postgresql.Driver, but this module never actually
         depended on the postgresql driver jar itself - any real jdbc source/sink use would have
         failed at runtime with no driver found, untested until now (see this module's own
         SparkSqlConnectorIntegrationTest, renamed 2026-09-14 from SparkJdbcSinkIntegrationTest once
         it gained real jdbc source-read coverage alongside its existing sink coverage). -->
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
    <dependency>
      <!-- SparkSinks' own NDJSON serialization of merged rows before saveAsTextFile/kafka writes. -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <!-- Test-only: SparkSqlConnectorIntegrationTest/SparkOpenSearchConnectorIntegrationTest/
         SparkKafkaConnectorIntegrationTest prove each new connector against a real service, not
         mocked - matching this org's own testing convention (and, since 2026-09-14, executor-
         pekko's own {Connector}ConnectorIntegrationTest naming exactly, prefixed with Spark). -->
    <dependency><groupId>com.forwardmeasure.testcontainers</groupId><artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.forwardmeasure.testcontainers</groupId><artifactId>forwardmeasure-testcontainers-postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.forwardmeasure.testcontainers</groupId><artifactId>forwardmeasure-testcontainers-opensearch</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-kafka</artifactId><scope>test</scope></dependency>
    <!-- Real artifactId confirmed from the actual cached BOM (2.0.5) - testcontainers 2.x renamed
         this from the older "junit-jupiter" (1.x) to "testcontainers-junit-jupiter", the exact same
         renaming pattern as testcontainers-kafka above; missed the first time this was added, only
         verified for -kafka, not this one. -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <!-- This module is a plain Java main() entrypoint (SparkIngestionRunner, constructing its own
         local/embedded SparkSession - not a spark-submit-orchestrated deployment), not a
         Quarkus/Spring/Micronaut app. Mirrors fei's own real ingestion-worker-spark pom exactly:
         maven-dependency-plugin copies runtime deps to target/dependency/, maven-jar-plugin points
         the jar's own manifest Class-Path at them. -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.forwardmeasure.datastreaming.executor.spark.SparkIngestionRunner</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>dependency/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                    <args>
                      <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                      <DEPENDENCY_DIR>target/dependency</DEPENDENCY_DIR>
                      <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
