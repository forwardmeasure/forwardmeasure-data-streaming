helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true

releases:
  # Real precondition this release closes (environments/gcp-openworkflow-prod.yaml.gotmpl's own
  # comment on authorizationClientId/credentialsSecretName): before this Job runs, nothing creates
  # the "datastreaming" Keycloak client or data-streaming-launcher-credentials - the launcher pod
  # below would come up but every fowf call it makes would fail authorization/auth closed. A
  # one-off dedicated chart (not the shared java-microservice chart) because this Job's job is
  # managing a Kubernetes Secret's own lifecycle (create-if-absent, patch-if-present) against
  # fowf's shared Keycloak - not deploying a long-running service.
  #
  # Deliberately in the SAME sub-helmfile as the launcher release below, not a separate one -
  # helmfile's own `needs` only resolves within one sub-helmfile's release list (confirmed live:
  # referencing this release from a separate helmfiles/credentials.yaml.gotmpl produced "depend(s)
  # on an undefined release" even though the release genuinely exists) - mirrors
  # forwardmeasure-openworkflow's own helmfiles/security.yaml.gotmpl, which keeps
  # openworkflow-k2-security and openworkflow-platform-clients (an identical needs relationship)
  # in one file for the same reason.
  #
  # Deliberately self-contained in THIS repo's own namespace, not built as an extension of
  # forwardmeasure-openworkflow's own openworkflow-platform-clients release (which does the
  # identical thing for fei's author/publisher identities) - that release's Job runs during fowf's
  # OWN install step, before forwardmeasure-data-streaming's own namespace/Secret exist at all
  # (install-platform.sh's real order is platform -> openworkflow -> data-streaming), so it
  # structurally cannot patch a Secret here yet. Needs only the narrow Keycloak admin credential
  # (forwardmeasure-platform's own platform-secrets release, identity.dataStreamingCredentialsSecret,
  # synced into this namespace specifically for this Job - not the full fowf identity bundle).
  - name: data-streaming-credentials
    namespace: {{ .Values.platform.namespaces.dataStreaming }}
    chart: ../releases/data-streaming-credentials
    values:
      - keycloak:
          url: {{ .Values.platform.endpoints.keycloak.url | quote }}
          realm: {{ .Values.platform.endpoints.keycloak.realm | quote }}
          clientUuid: {{ dig "keycloak" "clientUuid" "00000000-0000-0000-0000-000000000001" .Values | quote }}
          clientId: {{ dig "keycloak" "clientId" "openworkflow" .Values | quote }}
          datastreamingClientId: {{ .Values.authorizationClientId | quote }}
          # This cluster's tenant, from forwardmeasure-platform's shared cluster file.
          tenantAlias: {{ (index .Values.platform.tenants 0).alias | quote }}
        credentialsSecretName: {{ .Values.platform.secrets.dataStreamingKeycloakAdmin | quote }}
        targetSecretName: {{ .Values.credentialsSecretName | quote }}
    labels: {stage: credentials, capability: data-streaming-credentials}

  - name: data-streaming-launcher-{{ .Values.launcherFramework }}
    namespace: {{ .Values.platform.namespaces.dataStreaming }}
    # Same shared chart forwardmeasure-openworkflow's own execution-management/definition-management
    # releases already use in this exact cluster (helmfiles/execution-services.yaml.gotmpl) - not a
    # second, competing chart choice.
    chart: forwardmeasure/java-microservice
    version: {{ .Values.chartVersions.forwardMeasureJavaMicroservice | quote }}
    missingFileHandler: Error
    # credentialsSecretName above must already carry authorization-client-secret/fowf-keycloak-
    # client-id/fowf-keycloak-client-secret before this pod starts, or it comes up unable to
    # authenticate to fowf at all - see helmfiles/credentials.yaml.gotmpl.
    needs:
      - {{ .Values.platform.namespaces.dataStreaming }}/data-streaming-credentials
    values:
      - serviceAccount:
          create: true
          name: data-streaming-launcher-{{ .Values.launcherFramework }}
        automountServiceAccountToken: false
        terminationGracePeriodSeconds: 30
        podSecurityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        services:
          data-streaming-launcher-{{ .Values.launcherFramework }}:
            enabled: true
            # Plain Deployment, not Knative - matches every other real service already running in
            # this cluster (forwardmeasure-openworkflow's own execution-management/definition-
            # management/engines all use deploymentMode: deployment); data-fabric-devops's own
            # data-streaming-launcher release used Knative, but that was data-fabric-prod's own
            # established convention, not something confirmed to exist in this cluster - don't
            # assume it here.
            deploymentMode: deployment
            framework: {{ .Values.launcherFramework }}
            runtime: jvm
            port: 8080
            database:
              enabled: false
            liquibaseWait:
              enabled: false
            replicas: 1
            resources:
              requests: {cpu: "250m", memory: "512Mi"}
              limits: {cpu: "1000m", memory: "1Gi"}
            image:
              repository: {{ printf "docker.io/forwardmeasure/data-streaming-launcher-%s" .Values.launcherFramework | quote }}
              tag: "1.1.0"
              pullPolicy: {{ .Values.imagePullPolicy }}
            env:
              # Direct-mode (bypass-fowf) dispatch target - this release's own namespace only.
              DATASTREAMING_LAUNCHER_K8S_NAMESPACES: {{ .Values.platform.namespaces.dataStreaming | quote }}
              DATASTREAMING_LAUNCHER_PEKKO_IMAGE: {{ printf "%s@%s" .Values.imageVersions.pekko.repository .Values.imageVersions.pekko.digest | quote }}
              DATASTREAMING_LAUNCHER_PEKKO_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_KAFKA_STREAMS_IMAGE: {{ printf "%s@%s" .Values.imageVersions.dataStreamingExecutorKafkaStreams.repository .Values.imageVersions.dataStreamingExecutorKafkaStreams.digest | quote }}
              DATASTREAMING_LAUNCHER_KAFKA_STREAMS_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_SPARK_IMAGE: {{ printf "%s@%s" .Values.imageVersions.spark.repository .Values.imageVersions.spark.digest | quote }}
              DATASTREAMING_LAUNCHER_SPARK_COMMAND: "java -jar /deployments/application.jar"
              DATASTREAMING_LAUNCHER_K8S_IMAGES: {{ printf "%s@%s,%s@%s,%s@%s" .Values.imageVersions.pekko.repository .Values.imageVersions.pekko.digest .Values.imageVersions.dataStreamingExecutorKafkaStreams.repository .Values.imageVersions.dataStreamingExecutorKafkaStreams.digest .Values.imageVersions.spark.repository .Values.imageVersions.spark.digest | quote }}
              DATASTREAMING_LAUNCHER_K8S_IMAGE_PULL_SECRETS: {{ .Values.platform.secrets.imagePull | quote }}
              DATASTREAMING_LAUNCHER_KAFKA_BOOTSTRAP_SERVERS: {{ .Values.platform.endpoints.kafka.bootstrapServers | quote }}
              DATASTREAMING_LAUNCHER_FOWF_BASE_URL: {{ .Values.platform.endpoints.openworkflow.executionBaseUrl | quote }}
              DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_TOKEN_URL: {{ .Values.platform.endpoints.keycloak.tokenUrl | quote }}
              # Real bug fix (2026-09-26): none of the 4 vars below matched any real
              # @ConfigProperty/@Value key any of the 3 framework bindings actually read
              # (LauncherQuarkusBinding/LauncherSpringBinding/LauncherMicronautBinding all declare
              # `datastreaming.launcher.authorization.*`, no default value on any of the 7
              # properties AuthzenAuthorizationFactory.create(...) needs) - confirmed via direct
              # source read, not assumed. SmallRye Config/Spring relaxed binding/Micronaut all
              # derive the same env var name from that property path
              # (DATASTREAMING_LAUNCHER_AUTHORIZATION_*), which is what's used below now - the old
              # names (DATASTREAMING_KEYCLOAK_ISSUER, DATASTREAMING_ORGANIZATION_CLIENT_ID,
              # DATASTREAMING_AUTHORIZATION_CLIENT_ID/_ISSUER) never reached any of the 3
              # deployments' config at all; this launcher could never have booted as previously
              # wired. request-timeout/decision-ttl/maximum-cache-entries/policy-version were never
              # set under ANY name before - added here with the same defaults fowf's own
              # openworkflow.authorization block uses (application.yaml, engine-pekko/quarkus).
              DATASTREAMING_LAUNCHER_AUTHORIZATION_ISSUER: {{ .Values.platform.endpoints.keycloak.issuer | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_CLIENT_ID: {{ .Values.authorizationClientId | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_ORGANIZATION_CLIENT_ID: {{ .Values.platform.identity.organizationClientId | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_REQUEST_TIMEOUT: {{ dig "authorization" "requestTimeout" "PT5S" .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_DECISION_TTL: {{ dig "authorization" "decisionTtl" "PT5S" .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_MAXIMUM_CACHE_ENTRIES: {{ dig "authorization" "maximumCacheEntries" 10000 .Values | quote }}
              DATASTREAMING_LAUNCHER_AUTHORIZATION_POLICY_VERSION: {{ dig "authorization" "policyVersion" "v1" .Values | quote }}
            secrets:
              - envVar: DATASTREAMING_LAUNCHER_AUTHORIZATION_CLIENT_SECRET
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: authorization-client-secret
              - envVar: DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_CLIENT_ID
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: fowf-keycloak-client-id
              - envVar: DATASTREAMING_LAUNCHER_FOWF_KEYCLOAK_CLIENT_SECRET
                existingSecretName: {{ .Values.credentialsSecretName | quote }}
                secretKey: fowf-keycloak-client-secret
        imagePullSecrets:
          - name: {{ .Values.platform.secrets.imagePull }}
    labels: {stage: launcher, capability: data-streaming-launcher, framework: {{ .Values.launcherFramework }}}
